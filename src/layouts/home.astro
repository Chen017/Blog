---
import { Font } from "astro:assets";
import { profileConfig, siteConfig } from "@/config";
import { defaultFavicons } from "@constants/icon";
import { url } from "@utils/url";
import "@styles/voyage.css";
import NavigationMotion from "@components/site/NavigationMotion.astro";
import { ClientRouter } from "astro:transitions";

interface Props { title?: string; description?: string; lang?: string; article?: boolean; interior?: boolean; canonical?: string; postSlug?: string; }
const { title: pageTitle, description = "Notes on mathematics, code, and the rest of life. A personal blog by Eta Lib.", lang = "en", article = false, interior = false, canonical, postSlug } = Astro.props;
const title = pageTitle ? `${pageTitle} — ${siteConfig.title}` : `${siteConfig.title} — Mathematics, Code & Life`;
const favicons = siteConfig.favicon.length ? siteConfig.favicon : defaultFavicons;
const ogImage = siteConfig.generateOgImages && postSlug ? new URL(`/og/${postSlug}.png`, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang={lang.replace("_", "-")} class="dark" data-theme="github-dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#080c17" />
        <NavigationMotion />
        <ClientRouter />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content={profileConfig.name} />
        {Boolean(siteConfig.keywords?.length) && <meta name="keywords" content={siteConfig.keywords?.join(", ")} />}
        <link rel="canonical" href={new URL(canonical || Astro.url.pathname, Astro.site)} />
        <meta property="og:type" content={article ? "article" : "website"} />
        <meta property="og:site_name" content={siteConfig.title} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={Astro.url} />
        {ogImage && <meta property="og:image" content={ogImage} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}
        <Font cssVariable="--font-voyage-sans" preload={[{ weight: 400, style: "normal" }]} />
        <Font cssVariable="--font-voyage-serif" preload={[{ weight: 400, style: "normal" }, { weight: 400, style: "italic" }]} />
        {favicons.map(favicon => <link rel="icon" href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src} sizes={favicon.sizes} media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`} />)}
        <script is:inline>
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'github-dark');
            try {
                const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
                document.documentElement.dataset.motion = reduced ? 'off' : 'on';
                if (!reduced) {
                    document.documentElement.setAttribute('data-voyage-preparing', '');
                    try {
                        if (location.pathname === '/' && !location.hash && !history.state?.voyage && !sessionStorage.getItem('voyage:opened')) document.documentElement.setAttribute('data-voyage-opening', '');
                    } catch { /* Keep the opening visible if storage is unavailable. */ }
                    setTimeout(() => { if (!document.documentElement.hasAttribute('data-voyage-observing')) document.documentElement.removeAttribute('data-voyage-preparing'); document.documentElement.removeAttribute('data-voyage-opening'); }, 5000);
                }
            } catch { /* CSS also respects the system preference. */ }
        </script>
        <script defer src="https://cloud.umami.is/script.js" data-website-id="6f7ec1f7-de68-4a99-9eaf-3e395237e061"></script>
        <slot name="head" />
    </head>
    <body class={interior ? "voyage-interior" : "voyage-home"}><slot /></body>
</html>
