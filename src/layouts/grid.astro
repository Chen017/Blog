---
import type { MarkdownHeading } from "astro";
import VoyageDocument from "./home.astro";
import Backdrop from "@components/site/Backdrop.astro";
import Header from "@components/site/Header.astro";
import Footer from "@components/site/Footer.astro";
import Toc from "@components/sidebar/toc.astro";
import TocButton from "@components/tocButton.astro";
import BackToTop from "@components/back2TopButton.astro";
import "@styles/main.css";
import "@styles/variables.styl";
import "@styles/interior.css";

interface Props {
    title?: string; description?: string; lang?: string; banner?: string;
    setOGTypeArticle?: boolean; postSlug?: string; headings?: MarkdownHeading[]; canonical?: string; dynamicOutline?: boolean;
}
const { title, description, lang, setOGTypeArticle, postSlug, headings = [], canonical, dynamicOutline = false } = Astro.props;
const hasOutline = headings.length > 0 || dynamicOutline;
const hasIntro = Astro.slots.has("intro");
---
<VoyageDocument {title} {description} {lang} {canonical} {postSlug} article={setOGTypeArticle} interior>
    <slot slot="head" name="head" />
    <a class="nv-skip" href="#site-main">Skip to content</a>
    <div id="voyage-afterhours"><div class="nv-page vs-interior" data-motion="on" data-route={Astro.url.pathname}>
        <Backdrop /><Header />
        <main id="site-main" tabindex="-1">
            {hasIntro && <div class="vs-article-intro"><slot name="intro" /></div>}
            <div class:list={["vs-shell", { "vs-reading": hasOutline, "vs-article-layout": hasIntro, "vs-single-reading": hasIntro && !hasOutline }]}>
                {hasIntro && <aside class="vs-reading-progress" aria-label="Reading progress"><span>READING</span><div class="vs-progress-track"><i data-progress-bar></i><input data-progress-input type="range" min="0" max="100" step="1" value="0" aria-label="Reading position" aria-valuetext="0%" disabled /></div><output data-progress-value>0%</output><a href="/#nv-writing">All writing ↗</a></aside>}
                <div id="content-wrapper"><slot /></div>
                {hasOutline && <aside class="vs-outline" aria-label="Article outline"><Toc depth={6} /></aside>}
            </div>
        </main>
        <Footer />
        {hasOutline && <TocButton />}
        <BackToTop />
    </div></div>
</VoyageDocument>
<script>import "../scripts/site";</script>
