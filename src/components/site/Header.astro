---
import { Icon } from "astro-icon/components";
import { getSortedPostsList } from "@utils/content";
import { getPostUrl } from "@utils/url";
import { localIcons } from "@utils/local-icons";
import Search from "@components/navbar/search.svelte";
const home = Astro.url.pathname === "/";
const posts = await getSortedPostsList();
const titles = Object.fromEntries(posts.map(post => [getPostUrl(post), post.data.title]));
const icons = localIcons(["material-symbols:search", "material-symbols:close"]);
const links = [
    { name: "Home", href: home ? "#nv-home" : "/", active: home },
    { name: "Writing", href: "/archive/", active: Astro.url.pathname === "/archive/" || Astro.url.pathname.startsWith("/posts/") || /^\/\d+\/$/.test(Astro.url.pathname) },
    { name: "Links", href: "/friends/", active: Astro.url.pathname === "/friends/" },
    { name: "About", href: "/about/", active: Astro.url.pathname === "/about/" },
];
---
<header class="nv-header" transition:name="voyage-header">
    <a class="nv-brand" href={home ? "#nv-home" : "/"} data-astro-prefetch="false"><Icon name="mdi:orbit" aria-hidden="true" /><span>AI</span></a>
    <nav class="nv-nav" aria-label="Main navigation">{links.map(link => <a href={link.href} aria-current={link.active ? "page" : undefined} data-astro-prefetch="false">{link.name}</a>)}</nav>
    <div class="nv-tools" transition:persist="voyage-search"><Search client:load {icons} variant="voyage" {titles} /></div>
</header>
