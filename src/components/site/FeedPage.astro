---
import { getSortedPosts } from "@utils/content";
import { getPostUrl } from "@utils/url";
import { homePostCopy } from "@utils/home-post";
import GridLayout from "@layouts/grid.astro";
interface Props { format: "rss" | "atom"; }
const { format } = Astro.props;
const name = format === "rss" ? "RSS" : "Atom";
const address = new URL(`/${format}.xml`, Astro.site).toString();
const posts = (await getSortedPosts()).filter(post => !post.data.encrypted).sort((a,b) => b.data.published!.getTime() - a.data.published!.getTime()).slice(0,6);
---
<GridLayout title={`${name} feed`} description="Follow new writing in your own feed reader.">
    <section class="vs-feeds">
        <header class="vs-page-head"><span class="vs-kicker">FOLLOW THE WRITING</span><h1>Read in your <em>own space.</em></h1><p>New entries from Etalib’s Space, delivered to your {name} reader.</p></header>
        <div class="vs-feed-url"><a href={`/${format}.xml`}><code>{address}</code></a><button type="button" data-copy-url={address} aria-live="polite">Copy feed URL</button></div>
        <p class="vs-feed-info">Paste this address into the feed reader you already use. You can follow new writing without creating an account. This is the {name} feed; <a href={format === "rss" ? "/atom/" : "/rss/"}>the {format === "rss" ? "Atom" : "RSS"} version is also available ↗</a>.</p>
        <section class="vs-feed-recent" aria-label="Recent entries"><h2>Recently written</h2>{posts.map(post => <a class="vs-feed-entry" href={getPostUrl(post)}><time datetime={post.data.published!.toISOString()}>{post.data.published!.toISOString().slice(0,10)}</time><strong>{homePostCopy(post.data).title}</strong></a>)}</section>
    </section>
</GridLayout>
