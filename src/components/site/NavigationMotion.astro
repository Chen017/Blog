<!-- Coordinate the selected title with Astro's page-transition lifecycle. -->
<script is:inline>
(() => {
  if (window.__voyageNavigationMotion) return;
  window.__voyageNavigationMotion = true;
  const read = () => { try { return JSON.parse(sessionStorage.getItem('voyage:source') || 'null'); } catch { return null; } };
  const write = value => { try { sessionStorage.setItem('voyage:source', JSON.stringify(value)); } catch {} };
  const path = value => { try { return new URL(value, location.href).pathname; } catch { return ''; } };
  const post = value => value.startsWith('/posts/');
  const tabs = ['/', '/archive/', '/friends/', '/about/'];
  const tabSet = new Set(tabs);
  const activeNavHref = target => target === '/' ? '/' : (post(target) || /^\/\d+\/$/.test(target) ? '/archive/' : target);
  const syncNav = target => {
    const current = activeNavHref(target);
    document.querySelectorAll?.('#voyage-afterhours .nv-nav a[href]').forEach(link => {
      const href = link.getAttribute?.('href');
      const active = (current === '/' && (href === '/' || href === '#nv-home')) || href === current;
      if (active) link.setAttribute?.('aria-current', 'page');
      else link.removeAttribute?.('aria-current');
    });
  };
  const pageCache = new Map();
  const warmStyles = html => {
    try {
      const head = document.head;
      if (!head?.querySelector) return;
      for (const match of html.matchAll(/<link\b[^>]*rel=["']stylesheet["'][^>]*href=["']([^"']+)["'][^>]*>/gi)) {
        const href = match[1];
        if (href && !head.querySelector(`link[href="${href}"]`)) {
          const link = document.createElement('link');
          link.rel = 'prefetch';
          link.as = 'style';
          link.href = href;
          head.appendChild(link);
        }
      }
      for (const match of html.matchAll(/(?:<script\b[^>]*type=["']module["'][^>]*src|component-url|renderer-url)=["'](\/_astro\/[^"']+\.js)["']/gi)) {
        const src = match[1];
        if (src && !head.querySelector(`link[href="${src}"], script[src="${src}"]`)) {
          const link = document.createElement('link');
          link.rel = 'prefetch';
          link.as = 'script';
          link.href = src;
          head.appendChild(link);
        }
      }
    } catch {}
  };
  const nativeFetch = typeof window.fetch === 'function' ? window.fetch.bind(window) : null;
  if (nativeFetch && typeof Response === 'function') {
    const fetchTab = (key, init) => {
      if (!pageCache.has(key)) {
        const canonicalUrl = new URL(key, location.origin).href;
        const request = nativeFetch(canonicalUrl, init).then(async res => {
          const contentType = res.headers?.get?.('content-type') || 'text/html; charset=utf-8';
          if (!res.ok || res.redirected || !contentType.includes('text/html')) {
            pageCache.delete(key);
            return res;
          }
          const body = await res.text();
          warmStyles(body);
          const entry = { body, status: res.status, statusText: res.statusText, headers: { 'content-type': contentType } };
          pageCache.set(key, Promise.resolve(entry));
          return new Response(entry.body, entry);
        }).catch(err => {
          pageCache.delete(key);
          throw err;
        });
        pageCache.set(key, request);
        return request;
      }
      return pageCache.get(key).then(entry => entry instanceof Response ? entry.clone() : new Response(entry.body, entry));
    };
    window.fetch = (input, init) => {
      const method = (init?.method || (typeof Request === 'function' && input instanceof Request ? input.method : 'GET')).toUpperCase();
      if (method === 'GET') {
        const rawUrl = typeof input === 'string' || input instanceof URL ? String(input) : input?.url || '';
        try {
          const parsed = new URL(rawUrl, location.href);
          if (parsed.origin === location.origin && tabSet.has(parsed.pathname)) {
            return fetchTab(parsed.pathname, init);
          }
        } catch {}
      }
      return nativeFetch(input, init);
    };
    const warmAllTabs = () => {
      if (typeof navigator !== 'undefined' && navigator.webdriver) return;
      tabs.forEach((tab, index) => {
        if (tab === location.pathname || pageCache.has(tab)) return;
        setTimeout(() => {
          if (!pageCache.has(tab)) void fetchTab(tab, { priority: 'low' }).catch(() => {});
        }, index * 300);
      });
    };
    const scheduleWarm = () => {
      setTimeout(() => {
        if (typeof requestIdleCallback === 'function') requestIdleCallback(warmAllTabs, { timeout: 2000 });
        else warmAllTabs();
      }, 1500);
    };
    if (document.readyState === 'complete') scheduleWarm();
    else window.addEventListener?.('load', scheduleWarm, { once: true });
    const warmLinkTarget = event => {
      const link = event?.target?.closest?.('#voyage-afterhours .nv-nav a[href], #voyage-afterhours .nv-brand[href]');
      if (!link) return;
      const targetPath = path(link.getAttribute?.('href') || link.href || '');
      if (tabSet.has(targetPath) && !pageCache.has(targetPath)) void fetchTab(targetPath).catch(() => {});
    };
    window.addEventListener?.('pointerover', warmLinkTarget, { passive: true });
    window.addEventListener?.('touchstart', warmLinkTarget, { passive: true });
    window.addEventListener?.('focusin', warmLinkTarget, { passive: true });
  }
  let selected;
  let generation = 0;
  document.addEventListener('click', event => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target.closest?.('a[href]');
    if (!link || link.target || link.hasAttribute('download')) return;
    const card = link.closest?.('[data-entry-route]');
    const destination = new URL(link.href, location.href);
    if (destination.origin !== location.origin) return;
    if (card) {
      write({ post: destination.pathname, current: destination.pathname, from: location.pathname, card: card.id, originIndex: history.state?.index });
      return;
    }
    const from = location.pathname;
    const to = destination.pathname;
    if ((from === '/' || to === '/') && from !== to) {
      document.documentElement.setAttribute("data-voyage-home-transition", "");
      const nearTop = typeof window.scrollY !== 'number' || window.scrollY < 200;
      if (!destination.hash && (from !== '/' || nearTop)) {
        document.documentElement.setAttribute("data-voyage-home-fold-deferred", "");
      }
    }
  }, true);
  document.addEventListener('astro:before-preparation', event => {
    generation++;
    window.__voyageHomeTransition = null;
    document.documentElement.removeAttribute("data-voyage-entry-transition");
    document.documentElement.removeAttribute("data-voyage-home-transition");
    document.documentElement.removeAttribute("data-voyage-home-fold-deferred");
    document.querySelectorAll('[style*="voyage-entry-title"]').forEach(node => node.style.removeProperty('view-transition-name'));
    const from = path(event.from), to = path(event.to);
    syncNav(to);
    const link = event.sourceElement?.closest?.('a[href]');
    const card = link?.closest('[data-entry-route]');
    if (card && !post(from) && post(to)) write({ post: to, current: to, from, card: card.id, originIndex: history.state?.index });
    let source = read();
    if (source && post(from) && post(to) && source.current === from) { source.current = to; write(source); }
    const fromTab = tabs.indexOf(from), toTab = tabs.indexOf(to);
    const effectiveFromTab = fromTab >= 0 ? fromTab : (post(from) || /^\/\d+\/$/.test(from) ? 1 : -1);
    if (effectiveFromTab >= 0 && toTab >= 0 && effectiveFromTab !== toTab) event.direction = toTab < effectiveFromTab ? 'back' : 'forward';
    else if (post(from) && post(to) && link?.dataset.direction) event.direction = link.dataset.direction === 'previous' ? 'back' : 'forward';
    selected = source && ((post(to) && !post(from) && source.post === to && source.from === from) || (post(from) && !post(to) && source.post === from && source.from === to)) ? source : null;
    const homeBoundary = (from === '/' || to === '/') && from !== to;
    if (homeBoundary) {
      document.documentElement.setAttribute("data-voyage-home-transition", "");
      const hasHash = Boolean(event.to?.hash);
      const nearTop = typeof window.scrollY !== 'number' || window.scrollY < 200;
      if (!selected && !hasHash && (from !== '/' || nearTop)) {
        document.documentElement.setAttribute("data-voyage-home-fold-deferred", "");
      }
    }
    if (!selected) return;
    document.documentElement.setAttribute("data-voyage-entry-transition", "");
    const title = post(from) ? document.querySelector('.vs-article-head h1') : document.getElementById(source.card)?.querySelector('[data-entry-title]');
    if (title) title.style.viewTransitionName = 'voyage-entry-title';
  });
  document.addEventListener('astro:before-swap', event => {
    const from = path(event.from);
    const to = path(event.to);
    const incoming = event.newDocument;
    if (incoming?.head && document.head?.querySelectorAll) {
      document.head.querySelectorAll('link[rel="stylesheet"][href^="/_astro/"]').forEach(link => {
        const href = link.getAttribute?.('href');
        if (href && !incoming.head.querySelector?.(`link[rel="stylesheet"][href="${href}"]`)) {
          const clone = link.cloneNode ? link.cloneNode(true) : null;
          if (clone) incoming.head.appendChild?.(clone);
        }
      });
    }
    const homeBoundary = (from === '/' || to === '/') && from !== to;
    if (homeBoundary) {
      incoming?.documentElement?.setAttribute?.("data-voyage-home-transition", "");
      const savedScroll = typeof history !== 'undefined' ? history.state?.voyage?.scroll : 0;
      const hasHash = Boolean(event.to?.hash);
      if (to === '/' && !selected && !hasHash && !(Number.isFinite(savedScroll) && savedScroll > 120)) {
        incoming?.documentElement?.setAttribute?.("data-voyage-home-fold-deferred", "");
      }
      const transition = event.viewTransition;
      const current = generation;
      const clearHomeFlags = () => {
        if (current !== generation) return;
        document.documentElement.removeAttribute("data-voyage-home-transition");
        document.documentElement.removeAttribute("data-voyage-home-fold-deferred");
      };
      if (transition?.finished) void transition.finished.then(clearHomeFlags, clearHomeFlags);
      else clearHomeFlags();
    }
    if (to === '/' && from !== '/') {
      const finished = event.viewTransition?.finished;
      window.__voyageHomeTransition = {
        id: generation,
        from,
        finished: finished ? finished.then(() => {}, () => {}) : Promise.resolve(),
      };
    }
    if (!selected) return;
    incoming.documentElement?.setAttribute("data-voyage-entry-transition", "");
    const title = post(path(event.to)) ? incoming.querySelector('.vs-article-head h1') : incoming.getElementById(selected.card)?.querySelector('[data-entry-title]');
    if (title) title.style.viewTransitionName = 'voyage-entry-title';
    const transition = event.viewTransition;
    const current = generation;
    const cleanup = () => {
      if (current !== generation) return;
      document.documentElement.removeAttribute("data-voyage-entry-transition");
      document.querySelectorAll('[style*="voyage-entry-title"]').forEach(node => node.style.removeProperty('view-transition-name'));
    };
    if (transition) void transition.finished.then(cleanup, cleanup); else cleanup();
  });
  document.addEventListener('astro:page-load', () => {
    if (!post(location.pathname)) { try { sessionStorage.removeItem('voyage:source'); } catch {} }
  });
})();
</script>
