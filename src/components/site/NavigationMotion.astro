<!-- Coordinate the selected title with Astro's page-transition lifecycle. -->
<script is:inline>
(() => {
  if (window.__voyageNavigationMotion) return;
  window.__voyageNavigationMotion = true;
  const read = () => { try { return JSON.parse(sessionStorage.getItem('voyage:source') || 'null'); } catch { return null; } };
  const write = value => { try { sessionStorage.setItem('voyage:source', JSON.stringify(value)); } catch {} };
  const path = value => { try { return new URL(value, location.href).pathname; } catch { return ''; } };
  const post = value => value.startsWith('/posts/');
  const tabs = ['/', '/archive/', '/friends/', '/about/'];
  const tabSet = new Set(tabs);
  const resolveCardScroll = card => {
    let y = typeof window.scrollY === 'number' ? window.scrollY : 0;
    try {
      const titleEl = card?.querySelector?.('[data-entry-title]') || card;
      const rect = titleEl?.getBoundingClientRect?.();
      const vh = typeof window.innerHeight === 'number' ? window.innerHeight : 0;
      if (rect && vh > 0 && (rect.bottom > vh - 24 || rect.top < 88)) {
        y = Math.max(0, Math.round(y + rect.top - vh * 0.6));
      }
    } catch {}
    return y;
  };
  const pageCache = new Map();
  const postCache = new Map();
  const pageCacheTime = new Map();
  const postCacheTime = new Map();
  // Revalidate a stale HTML snapshot without delaying a warm navigation.
  // Very old snapshots must be fetched again to avoid broken deployment assets.
  const softTtlMs = 5 * 60 * 1000;
  const maxStaleMs = 60 * 60 * 1000;
  const warmedAssets = new Set();
  let hoverTimer = 0;
  const nativeFetch = typeof window.fetch === 'function' ? window.fetch.bind(window) : null;
  const warmStyles = html => {
    try {
      if (!nativeFetch) return;
      const head = document.head;
      for (const match of html.matchAll(/<link\b[^>]*rel=["']stylesheet["'][^>]*href=["']([^"']+)["'][^>]*>/gi)) {
        const href = match[1];
        if (href && !warmedAssets.has(href) && !head?.querySelector?.(`link[href="${href}"]`)) {
          warmedAssets.add(href);
          void nativeFetch(new URL(href, location.origin).href, { priority: 'low', credentials: 'same-origin' }).catch(() => {});
        }
      }
      for (const match of html.matchAll(/(?:<script\b[^>]*type=["']module["'][^>]*src|component-url|renderer-url)=["'](\/_astro\/[^"']+\.js)["']/gi)) {
        const src = match[1];
        if (src && !warmedAssets.has(src) && !head?.querySelector?.(`script[src="${src}"]`)) {
          warmedAssets.add(src);
          void nativeFetch(new URL(src, location.origin).href, { priority: 'low', credentials: 'same-origin' }).catch(() => {});
        }
      }
    } catch {}
  };

  // Keep Astro's early inline listener registration. Only HTML is cached here;
  // immutable, hashed assets continue through the browser's normal HTTP cache.
  const refreshQueue = [];
  const refreshQueued = new Set();
  const retryAfter = new Map();
  let refreshBusy = false;
  let refreshTimer = 0;
  let serverBackoffUntil = 0;
  const conserveData = () => {
    const connection = typeof navigator !== 'undefined' ? navigator.connection : null;
    return Boolean(connection?.saveData || connection?.effectiveType === 'slow-2g' || connection?.effectiveType === '2g');
  };
  const canWarm = () => !document.hidden && !conserveData()
    && (typeof navigator === 'undefined' || navigator.onLine !== false);
  const stale = (times, key) => Date.now() - (times.get(key) ?? 0) > softTtlMs;
  const tooOld = (times, key) => Date.now() - (times.get(key) ?? 0) > maxStaleMs;

  // A single low-priority refresh at a time, with spacing and a retry backoff,
  // prevents a foreground return from causing concurrent CDN requests.
  const drainRefreshQueue = () => {
    refreshTimer = 0;
    if (refreshBusy || !refreshQueue.length) return;
    if (!canWarm()) {
      refreshQueue.splice(0).forEach(task => refreshQueued.delete(task.key));
      return;
    }
    if (Date.now() < serverBackoffUntil) {
      refreshTimer = setTimeout(drainRefreshQueue, serverBackoffUntil - Date.now());
      return;
    }
    const { key, cache, times, snapshot } = refreshQueue.shift();
    if (cache.get(key) !== snapshot) {
      refreshQueued.delete(key);
      if (refreshQueue.length) refreshTimer = setTimeout(drainRefreshQueue, 400);
      return;
    }
    refreshBusy = true;
    const postpone = () => retryAfter.set(key, Date.now() + 60 * 1000);
    void nativeFetch(new URL(key, location.origin).href, {
      cache: 'no-cache', credentials: 'same-origin', priority: 'low',
    }).then(async res => {
      if (cache.get(key) !== snapshot) return;
      // A 304 is normally resolved by the browser HTTP cache into a 200.
      if (res.status === 304) {
        times.set(key, Date.now());
        return;
      }
      if (res.status === 404 || res.status === 410) {
        cache.delete(key);
        times.delete(key);
        retryAfter.delete(key);
        return;
      }
      const type = res.headers?.get?.('content-type') || '';
      if (!res.ok || res.redirected || !type.includes('text/html')) {
        postpone();
        if (res.status >= 500) serverBackoffUntil = Date.now() + 60 * 1000;
        return;
      }
      const body = await res.text();
      if (cache.get(key) !== snapshot) return;
      const entry = { body, status: res.status, statusText: res.statusText, headers: { 'content-type': type } };
      cache.set(key, Promise.resolve(entry));
      times.set(key, Date.now());
      retryAfter.delete(key);
      warmStyles(body);
    }).catch(postpone).finally(() => {
      refreshBusy = false;
      refreshQueued.delete(key);
      if (refreshQueue.length) refreshTimer = setTimeout(drainRefreshQueue, 400);
    });
  };
  const queueRefresh = (key, cache, times) => {
    if (!cache.has(key) || !canWarm() || refreshQueued.has(key) ||
        Date.now() < serverBackoffUntil || Date.now() < (retryAfter.get(key) || 0)) return;
    refreshQueued.add(key);
    refreshQueue.push({ key, cache, times, snapshot: cache.get(key) });
    if (!refreshBusy && !refreshTimer) refreshTimer = setTimeout(drainRefreshQueue, 0);
  };
  const checkAge = (key, cache, times) => {
    if (!cache.has(key)) return;
    if (tooOld(times, key) && (typeof navigator === 'undefined' || navigator.onLine !== false)) {
      cache.delete(key);
      times.delete(key);
      retryAfter.delete(key);
      return;
    }
    if (stale(times, key)) queueRefresh(key, cache, times);
  };
  const refreshStaleTabs = () => {
    if (!canWarm()) return;
    tabs.forEach(key => {
      if (pageCache.has(key) && stale(pageCacheTime, key)) queueRefresh(key, pageCache, pageCacheTime);
    });
  };
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refreshStaleTabs();
  });
  window.addEventListener?.('pageshow', event => {
    if (event.persisted) refreshStaleTabs();
  });
  if (nativeFetch && typeof Response === 'function') {
    const fetchTab = (key, init) => {
      checkAge(key, pageCache, pageCacheTime);
      if (!pageCache.has(key)) {
        pageCacheTime.set(key, Date.now());
        const canonicalUrl = new URL(key, location.origin).href;
        const request = nativeFetch(canonicalUrl, init).then(async res => {
          const contentType = res.headers?.get?.('content-type') || 'text/html; charset=utf-8';
          if (!res.ok || res.redirected || !contentType.includes('text/html')) {
            pageCache.delete(key);
            pageCacheTime.delete(key);
            return res;
          }
          const body = await res.text();
          warmStyles(body);
          const entry = { body, status: res.status, statusText: res.statusText, headers: { 'content-type': contentType } };
          pageCache.set(key, Promise.resolve(entry));
          return new Response(entry.body, entry);
        }).catch(err => {
          pageCache.delete(key);
          pageCacheTime.delete(key);
          throw err;
        });
        pageCache.set(key, request);
        return request;
      }
      return pageCache.get(key).then(entry => entry instanceof Response ? entry.clone() : new Response(entry.body, entry));
    };
    const fetchPost = (key, init) => {
      checkAge(key, postCache, postCacheTime);
      if (!postCache.has(key)) {
        postCacheTime.set(key, Date.now());
        const canonicalUrl = new URL(key, location.origin).href;
        const request = nativeFetch(canonicalUrl, init).then(async res => {
          const contentType = res.headers?.get?.('content-type') || 'text/html; charset=utf-8';
          if (!res.ok || res.redirected || !contentType.includes('text/html')) {
            postCache.delete(key);
            postCacheTime.delete(key);
            return res;
          }
          const body = await res.text();
          warmStyles(body);
          const entry = { body, status: res.status, statusText: res.statusText, headers: { 'content-type': contentType } };
          postCache.delete(key);
          postCache.set(key, Promise.resolve(entry));
          if (postCache.size > 6) {
            const oldest = postCache.keys().next().value;
            if (oldest && oldest !== key) {
              postCache.delete(oldest);
              postCacheTime.delete(oldest);
              retryAfter.delete(oldest);
            }
          }
          return new Response(entry.body, entry);
        }).catch(err => {
          postCache.delete(key);
          postCacheTime.delete(key);
          throw err;
        });
        postCache.set(key, request);
        return request;
      }
      const cached = postCache.get(key);
      postCache.delete(key);
      postCache.set(key, cached);
      return cached.then(entry => entry instanceof Response ? entry.clone() : new Response(entry.body, entry));
    };
    window.fetch = (input, init) => {
      const method = (init?.method || (typeof Request === 'function' && input instanceof Request ? input.method : 'GET')).toUpperCase();
      if (method === 'GET') {
        const rawUrl = typeof input === 'string' || input instanceof URL ? String(input) : input?.url || '';
        try {
          const parsed = new URL(rawUrl, location.href);
          // Query variants and non-default fetch modes may not represent canonical static HTML.
          // They must bypass path-only route caching rather than return the wrong document.
          if (parsed.search || parsed.hash || init?.cache === 'no-store' || init?.cache === 'reload') return nativeFetch(input, init);
          if (parsed.origin === location.origin) {
            if (tabSet.has(parsed.pathname)) {
              return fetchTab(parsed.pathname, init);
            }
            if (post(parsed.pathname) && postCache.has(parsed.pathname)) {
              return fetchPost(parsed.pathname, init);
            }
          }
        } catch {}
      }
      return nativeFetch(input, init);
    };
    const warmPostPath = targetPath => {
      if (post(targetPath) && (!postCache.has(targetPath) || stale(postCacheTime, targetPath))) {
        void fetchPost(targetPath, { priority: 'low', credentials: 'same-origin' }).catch(() => {});
      }
    };
    let tabsWarmed = false;
    const warmAllTabs = () => {
      if (tabsWarmed || !canWarm()) return;
      tabsWarmed = true;
      const queue = [];
      document.querySelectorAll?.('[data-entry-route]').forEach((el, idx) => {
        if (idx < 3) {
          const route = el.getAttribute?.('data-entry-route') || el.querySelector?.('a[href]')?.getAttribute?.('href') || '';
          const p = route ? path(route) : '';
          if (post(p) && !queue.includes(p)) queue.push(p);
        }
      });
      tabs.forEach(tab => {
        if (!queue.includes(tab)) queue.push(tab);
      });
      queue.forEach((route, index) => {
        setTimeout(() => {
          if (tabSet.has(route)) {
            if (!pageCache.has(route) || stale(pageCacheTime, route)) void fetchTab(route, { priority: 'low' }).catch(() => {});
          } else if (post(route)) {
            warmPostPath(route);
          }
        }, 50 + index * 140);
      });
    };
    if (document.readyState === 'complete') warmAllTabs();
    else window.addEventListener?.('load', warmAllTabs, { once: true, passive: true });
    const warmLinkTarget = event => {
      if (!canWarm()) return;
      const target = event?.target?.closest?.('#voyage-afterhours .nv-nav a[href], #voyage-afterhours .nv-brand[href], [data-entry-route] a[href], [data-entry-route], .vs-adjacent a[href], [data-source-back]');
      if (target) {
        const anchor = target.matches?.('a[href]') ? target : target.querySelector?.('a[href]');
        const rawHref = anchor?.getAttribute?.('href') || anchor?.href || target.getAttribute?.('data-entry-route') || '';
        const targetPath = rawHref ? path(rawHref) : '/';
        if (tabSet.has(targetPath) && (!pageCache.has(targetPath) || stale(pageCacheTime, targetPath))) {
          void fetchTab(targetPath).catch(() => {});
        } else if (post(targetPath) && (!postCache.has(targetPath) || stale(postCacheTime, targetPath))) {
          if (event.type === 'pointerover') {
            clearTimeout(hoverTimer);
            hoverTimer = setTimeout(() => warmPostPath(targetPath), 65);
          } else {
            clearTimeout(hoverTimer);
            warmPostPath(targetPath);
          }
        }
        if (tabSet.has(location.pathname) && (!pageCache.has(location.pathname) || stale(pageCacheTime, location.pathname))) {
          void fetchTab(location.pathname, { priority: 'low' }).catch(() => {});
        }
      }
      warmAllTabs();
    };
    window.addEventListener?.('pointerover', warmLinkTarget, { passive: true });
    window.addEventListener?.('pointerout', event => {
      if (hoverTimer && event?.target?.closest?.('[data-entry-route], .vs-adjacent a[href]')) {
        clearTimeout(hoverTimer);
        hoverTimer = 0;
      }
    }, { passive: true });
    window.addEventListener?.('pointerdown', warmLinkTarget, { passive: true });
    window.addEventListener?.('touchstart', warmLinkTarget, { passive: true });
    window.addEventListener?.('focusin', warmLinkTarget, { passive: true });
    window.addEventListener?.('pointermove', warmAllTabs, { once: true, passive: true });
    document.addEventListener('astro:page-load', refreshStaleTabs);
  }
  let selected;
  let generation = 0;
  document.addEventListener('click', event => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target.closest?.('a[href]');
    if (!link || link.target || link.hasAttribute('download')) return;
    const card = link.closest?.('[data-entry-route]');
    const destination = new URL(link.href, location.href);
    if (destination.origin !== location.origin) return;
    if (card) {
      card.setAttribute?.('data-entry-pressing', 'true');
      const scrollY = resolveCardScroll(card);
      write({ post: destination.pathname, current: destination.pathname, from: location.pathname, card: card.id, originIndex: history.state?.index, scrollY });
      return;
    }
    const from = location.pathname;
    const to = destination.pathname;
    if ((from === '/' || to === '/') && from !== to) {
      document.documentElement.setAttribute("data-voyage-home-transition", "");
      if (to === '/' && !destination.hash) {
        document.documentElement.setAttribute("data-voyage-home-fold-deferred", "");
      }
    }
  }, true);
  document.addEventListener('astro:before-preparation', event => {
    generation++;
    window.__voyageHomeTransition = null;
    window.__voyageTransitionFinished = null;
    document.documentElement.removeAttribute("data-voyage-entry-transition");
    document.documentElement.removeAttribute("data-voyage-home-transition");
    document.documentElement.removeAttribute("data-voyage-home-fold-deferred");
    document.documentElement.removeAttribute("data-voyage-home-fold-reveal");
    document.documentElement.removeAttribute("data-voyage-hero-capture");
    document.querySelectorAll('[style*="voyage-entry-title"]').forEach(node => node.style.removeProperty('view-transition-name'));
    const from = path(event.from), to = path(event.to);
    const link = event.sourceElement?.closest?.('a[href]');
    const card = link?.closest('[data-entry-route]');
    if (card && !post(from) && post(to)) {
      const existing = read();
      const scrollY = (existing && existing.post === to && existing.card === card.id && typeof existing.scrollY === 'number' && existing.scrollY > 0)
        ? existing.scrollY
        : resolveCardScroll(card);
      write({ post: to, current: to, from, card: card.id, originIndex: history.state?.index, scrollY });
    }
    let source = read();
    if (source && post(from) && post(to) && source.current === from) { source.current = to; write(source); }
    const fromTab = tabs.indexOf(from), toTab = tabs.indexOf(to);
    const effectiveFromTab = fromTab >= 0 ? fromTab : (post(from) || /^\/\d+\/$/.test(from) ? 1 : -1);
    if (effectiveFromTab >= 0 && toTab >= 0 && effectiveFromTab !== toTab) event.direction = toTab < effectiveFromTab ? 'back' : 'forward';
    else if (post(from) && post(to) && link?.dataset.direction) event.direction = link.dataset.direction === 'previous' ? 'back' : 'forward';
    selected = source && ((post(to) && !post(from) && source.post === to && source.from === from) || (post(from) && !post(to) && source.post === from && source.from === to)) ? source : null;
    const homeBoundary = (from === '/' || to === '/') && from !== to;
    if (homeBoundary) {
      document.documentElement.setAttribute("data-voyage-home-transition", "");
      const hasHash = Boolean(event.to?.hash);
      if (to === '/' && !selected && !hasHash) {
        document.documentElement.setAttribute("data-voyage-home-fold-deferred", "");
      }
    }
    if (!selected) return;
    document.documentElement.setAttribute("data-voyage-entry-transition", "");
    const title = post(from) ? document.querySelector('.vs-article-head h1') : document.getElementById(source.card)?.querySelector('[data-entry-title]');
    if (title) title.style.viewTransitionName = 'voyage-entry-title';
  });
  document.addEventListener('astro:before-swap', event => {
    const from = path(event.from);
    const to = path(event.to);
    const incoming = event.newDocument;
    const vtFinished = event.viewTransition?.finished;
    window.__voyageTransitionFinished = vtFinished ? vtFinished.then(() => {}, () => {}) : Promise.resolve();
    document.querySelectorAll?.('[data-entry-pressing]').forEach(el => el.removeAttribute?.('data-entry-pressing'));
    // Astro's ClientRouter swaps page-specific stylesheets and preserves shared ones.
    // Do not copy outgoing CSS into the incoming head: it leaks interior styles to Home.
    const homeBoundary = (from === '/' || to === '/') && from !== to;
    if (homeBoundary) {
      incoming?.documentElement?.setAttribute?.("data-voyage-home-transition", "");
      const savedScroll = typeof history !== 'undefined' ? history.state?.voyage?.scroll : 0;
      const hasHash = Boolean(event.to?.hash);
      const shouldDeferIncomingFold = to === '/' && !selected && !hasHash && !(Number.isFinite(savedScroll) && savedScroll > 120);
      if (shouldDeferIncomingFold) {
        incoming?.documentElement?.setAttribute?.("data-voyage-home-fold-deferred", "");
      }
      // Capture the returning hero title separately from the sliding root image,
      // so its additive blend is composited against the same sky as the live DOM.
      // Leave Post -> Home shared-title transitions unchanged.
      if (to === '/' && !selected && event.viewTransition && document.documentElement.dataset?.motion !== 'off') {
        incoming?.documentElement?.setAttribute?.("data-voyage-hero-capture", "");
      }
      const transition = event.viewTransition;
      const current = generation;
      const clearHomeFlags = () => {
        if (current !== generation) return;
        const wasDeferred = document.documentElement.hasAttribute("data-voyage-home-fold-deferred");
        document.documentElement.removeAttribute("data-voyage-home-transition");
        document.documentElement.removeAttribute("data-voyage-home-fold-deferred");
        document.documentElement.removeAttribute("data-voyage-hero-capture");
        if (to === '/' && (wasDeferred || shouldDeferIncomingFold)) {
          document.documentElement.setAttribute("data-voyage-home-fold-reveal", "");
          setTimeout(() => {
            if (current === generation) document.documentElement.removeAttribute("data-voyage-home-fold-reveal");
          }, 620);
        }
      };
      if (transition?.finished) void transition.finished.then(clearHomeFlags, clearHomeFlags);
      else clearHomeFlags();
    }
    if (to === '/' && from !== '/') {
      const finished = event.viewTransition?.finished;
      window.__voyageHomeTransition = {
        id: generation,
        from,
        finished: finished ? finished.then(() => {}, () => {}) : Promise.resolve(),
      };
    }
    if (!selected) return;
    incoming.documentElement?.setAttribute("data-voyage-entry-transition", "");
    if (to === '/' && incoming?.querySelectorAll) {
      try {
        const loadedCovers = window.__voyageLoadedCovers || (window.__voyageLoadedCovers = new Set());
        incoming.querySelectorAll('deferred-cover').forEach(cover => {
          const tpl = cover.querySelector?.('template');
          if (!tpl?.content) return;
          const cardId = cover.closest?.('[id]')?.id || '';
          // Only the paired title's cover (and already shown covers) may bypass lazy loading.
          if (!cardId || (cardId !== selected.card && !loadedCovers.has(cardId))) return;
          const clone = tpl.content.cloneNode(true);
          const img = clone.querySelector?.('img');
          if (img) {
            img.decoding = 'sync';
            img.loading = 'eager';
          }
          cover.insertBefore(clone, tpl);
          tpl.remove();
          cover.setAttribute?.('data-loaded', 'true');
          if (cardId) loadedCovers.add(cardId);
        });
      } catch {}
    }
    const title = post(path(event.to)) ? incoming.querySelector('.vs-article-head h1') : incoming.getElementById(selected.card)?.querySelector('[data-entry-title]');
    if (title) title.style.viewTransitionName = 'voyage-entry-title';
    const transition = event.viewTransition;
    const current = generation;
    const cleanup = () => {
      if (current !== generation) return;
      document.documentElement.removeAttribute("data-voyage-entry-transition");
      document.querySelectorAll('[style*="voyage-entry-title"]').forEach(node => node.style.removeProperty('view-transition-name'));
    };
    if (transition) void transition.finished.then(cleanup, cleanup); else cleanup();
  });
  document.addEventListener('astro:after-swap', () => {
    if (!selected || location.pathname !== '/') return;
    try {
      const cardEl = selected.card ? document.getElementById(selected.card) : null;
      const titleEl = cardEl?.querySelector?.('[data-entry-title]') || cardEl;
      if (!titleEl) return;
      if (typeof selected.scrollY === 'number' && selected.scrollY > 0 && window.scrollY !== selected.scrollY) {
        window.scrollTo?.({ top: selected.scrollY, behavior: 'instant' });
      }
      const rect = titleEl.getBoundingClientRect?.();
      const vh = typeof window.innerHeight === 'number' ? window.innerHeight : 0;
      if (rect && vh > 0 && (rect.bottom > vh - 24 || rect.top < 88)) {
        const currentY = typeof window.scrollY === 'number' ? window.scrollY : 0;
        const targetY = Math.max(0, Math.round(currentY + rect.top - vh * 0.6));
        window.scrollTo?.({ top: targetY, behavior: 'instant' });
      }
    } catch {}
  });
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll?.('[data-entry-pressing]').forEach(el => el.removeAttribute?.('data-entry-pressing'));
    if (!post(location.pathname)) { try { sessionStorage.removeItem('voyage:source'); } catch {} }
  });
})();
</script>
