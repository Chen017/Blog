---
import { url } from "@utils/url";
import { postConfig } from "@/config";


interface Props {
    path: string;
}

const config = {
    ...postConfig.comment.twikoo,
    el: "#comment-container",
    path: Astro.props.path,
};
---

<div id="comment-container"></div>
<script is:inline src={url("/assets/js/twikoo.all.min.js")}></script>
<link rel="stylesheet" href={url("/assets/css/twikoo.css")} />
<script is:inline define:vars={{ config }}>
(() => {
    window.__commentCleanup?.();
    let mountedElement;
    window.__commentCleanup = () => {
        clearTimeout(retry);
        mountedElement = undefined;
        window.removeEventListener('pagehide', pauseRetry);
        document.removeEventListener('twilight:page:loaded', initComments);
        document.removeEventListener('DOMContentLoaded', initComments);
    };
    let attempts = 0;
    let retry;
    function initComments() {
        const element = document.getElementById('comment-container');
        if (!element || mountedElement === element) return;
        clearTimeout(retry);
        if (typeof twikoo === 'undefined') {
            if (attempts++ < 5) retry = setTimeout(initComments, 500);
            else element.textContent = 'Comments could not load. Please refresh to retry.';
            return;
        }
        mountedElement = element;
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        Promise.resolve().then(() => twikoo.init({ ...config, path: currentPath, el: '#comment-container' }))
            .catch(error => {
                if (mountedElement === element) mountedElement = undefined;
                element.textContent = 'Comments could not load. Please refresh to retry.';
                console.error('[Twikoo] Initialization failed:', error);
            });
    }
    document.addEventListener('astro:before-swap', window.__commentCleanup, { once: true });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initComments, { once: true });
    else initComments();
    document.addEventListener('twilight:page:loaded', initComments);
    function pauseRetry() { clearTimeout(retry); }
    window.addEventListener('pagehide', pauseRetry);
})();
</script>
