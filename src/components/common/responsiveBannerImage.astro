---
import { getImage } from "astro:assets";
import desktopWallpaper from "../../assets/banners/desktopWallpaper.jpg";
import mobileWallpaper from "../../assets/banners/mobileWallpaper.jpg";
interface Props { desktop: string; mobile: string; alt: string; id?: string; class?: string; position?: string; loading?: 'eager' | 'lazy'; }
const { desktop, mobile, alt, id, class: className, position = 'center', loading = 'eager' } = Astro.props;
const originals = { '/assets/images/desktopWallpaper.jpg': desktopWallpaper, '/assets/images/mobileWallpaper.jpg': mobileWallpaper };
async function responsive(src: string, widths: number[], format: "webp" | "avif" = "webp") {
    const metadata = originals[src as keyof typeof originals];
    if (!metadata) return { src, srcset: undefined, width: undefined, height: undefined };
    const targets = [...new Set(widths.map(width => Math.min(width, metadata.width)))];
    const images = await Promise.all(targets.map(width => getImage({ src: metadata, width, format, quality: format === "avif" ? 70 : 82 })));
    return { src: images[0].src, srcset: images.map((image, i) => `${image.src} ${targets[i]}w`).join(', '), width: metadata.width, height: metadata.height };
}
const desktopImage = await responsive(desktop, [768, 1280, 1920]);
const mobileImage = await responsive(mobile || desktop, [390, 780]);
const mobileAvif = await responsive(mobile || desktop, [390, 780], "avif");
---
<div {id} class:list={[className, 'overflow-hidden relative']}>
    <picture class="block w-full h-full">
        {mobileAvif.srcset && <source media="(max-width: 767px)" type="image/avif" srcset={mobileAvif.srcset} sizes="100vw" />}
        <source media="(max-width: 767px)" srcset={mobileImage.srcset || mobileImage.src} sizes="100vw" />
        <img src={desktopImage.src} srcset={desktopImage.srcset} sizes="100vw" width={desktopImage.width} height={desktopImage.height}
            {alt} {loading} fetchpriority={loading === 'eager' ? 'high' : 'auto'} decoding="async"
            class="w-full h-full object-cover" style={`object-position: ${position}`} />
    </picture>
</div>
