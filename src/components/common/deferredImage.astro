---
interface Props { enabled: boolean; }
const { enabled } = Astro.props;
const markup = await Astro.slots.render("default");
---
{enabled ? (
    <deferred-cover class="block w-full h-full">
        <template set:html={markup} />
        <noscript set:html={markup} />
    </deferred-cover>
) : <Fragment set:html={markup} />}

<script>
    const loadedCovers = window.__voyageLoadedCovers || (window.__voyageLoadedCovers = new Set<string>());

    class DeferredCover extends HTMLElement {
        static observer = "IntersectionObserver" in window ? new IntersectionObserver(entries => {
            for (const entry of entries) {
                if (entry.isIntersecting) (entry.target as DeferredCover).reveal();
            }
        }, { rootMargin: "350px 0px" }) : null;

        coverKey(): string {
            const card = this.closest("[id]");
            if (card?.id) return card.id;
            const tpl = this.querySelector("template");
            return tpl?.innerHTML.slice(0, 120) || "";
        }

        connectedCallback() {
            if (!this.querySelector("template")) return;
            const key = this.coverKey();
            const isFoldDeferred = document.documentElement.hasAttribute("data-voyage-home-fold-deferred");
            // A page-level entry transition must never eagerly decode every cover.
            if (!isFoldDeferred && key && loadedCovers.has(key)) {
                this.reveal(true);
                return;
            }
            const startObserve = () => {
                if (!this.isConnected || !this.querySelector("template")) return;
                if (key && loadedCovers.has(key)) {
                    this.reveal(true);
                    return;
                }
                if (DeferredCover.observer) DeferredCover.observer.observe(this);
                else this.reveal();
            };
            const homeTransition = window.__voyageHomeTransition;
            if (homeTransition?.finished && isFoldDeferred) {
                void homeTransition.finished.then(startObserve, startObserve);
            } else {
                startObserve();
            }
        }

        disconnectedCallback() { DeferredCover.observer?.unobserve(this); }

        reveal(immediate = false) {
            const template = this.querySelector("template");
            if (!template) return;
            const key = this.coverKey();
            const content = template.content.cloneNode(true) as DocumentFragment;
            const image = content.querySelector("img");
            if (immediate) {
                if (image) {
                    image.decoding = "sync";
                    image.loading = "eager";
                }
                this.insertBefore(content, template);
                template.remove();
                this.dataset.loaded = "true";
                if (key) loadedCovers.add(key);
                DeferredCover.observer?.unobserve(this);
                return;
            }
            if (image) {
                this.dataset.loading = "true";
                const cleanup = () => {
                    image.removeEventListener("load", loaded);
                    image.removeEventListener("error", failed);
                };
                const loaded = async () => {
                    cleanup();
                    // A cached image can be complete before its load listener runs.
                    // Wait for decoding so the fade never reveals undecoded pixels.
                    try { await image.decode(); } catch { /* A responsive source may change while decoding. */ }
                    delete this.dataset.loading;
                    this.dataset.ready = "true";
                    if (key) loadedCovers.add(key);
                };
                const failed = () => {
                    cleanup();
                    delete this.dataset.loading;
                    this.dataset.error = "true";
                };
                image.addEventListener("load", loaded, { once: true });
                image.addEventListener("error", failed, { once: true });
                this.insertBefore(content, template);
                if (image.complete) {
                    if (image.naturalWidth > 0) void loaded();
                    else failed();
                }
            } else {
                this.insertBefore(content, template);
                if (key) loadedCovers.add(key);
            }
            template.remove();
            this.dataset.loaded = "true";
            DeferredCover.observer?.unobserve(this);
        }
    }
    if (!customElements.get("deferred-cover")) customElements.define("deferred-cover", DeferredCover);
</script>

<style>
    :global(deferred-cover[data-loading] img) { opacity: 0; }
    :global(deferred-cover[data-ready] img) { animation: cover-reveal 360ms ease-out both; }
    @keyframes cover-reveal {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
        :global(deferred-cover[data-ready] img) { animation: none; }
    }
</style>
