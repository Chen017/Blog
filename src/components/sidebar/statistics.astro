---
import { getCategoryList, getSortedPostsList } from '@utils/content';
import StatsCharts from './statistics.svelte';
const posts = await getSortedPostsList();
const categories = await getCategoryList();
const activity: Record<string, number> = {};
for (const post of posts) {
    if (!post.data.published) continue;
    const day = post.data.published.toISOString().slice(0, 10);
    activity[day] = (activity[day] || 0) + 1;
}
interface Props { class?: string; style?: string; side?: string; }
const { class: className, style, side = 'right' } = Astro.props;
---
<div id="statistics-single" data-owner={side}>
    <StatsCharts client:visible {activity} {categories} class={className} {style} />
</div>
