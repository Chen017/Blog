---
import { Icon } from "astro-icon/components";
---
<aside class="nv-complex" aria-label="Explore the complex plane">
  <div class="nv-plane-head"><span>the complex plane</span><button type="button" class="nv-tiny" data-plane-toggle disabled aria-label="Show formula as code" aria-pressed="false"><Icon name="mdi:code-tags" aria-hidden="true" /></button></div>
  <div class="nv-plane-canvas">
    <svg class="nv-plane" viewBox="0 0 240 178" role="img" aria-label="Complex unit circle with a point at 45 degrees">
      <line x1="25" y1="90" x2="213" y2="90" class="nv-plane-axis"/><line x1="112" y1="12" x2="112" y2="166" class="nv-plane-axis"/>
      <circle cx="112" cy="90" r="62" class="nv-plane-circle"/>
      <path data-phase d="M 134 90 A 22 22 0 0 0 127.56 74.44" class="nv-plane-phase"/>
      <line data-real-projection x1="155.84" y1="46.16" x2="155.84" y2="90" class="nv-plane-projection"/>
      <line data-imag-projection x1="112" y1="46.16" x2="155.84" y2="46.16" class="nv-plane-projection"/>
      <line data-radius x1="112" y1="90" x2="155.84" y2="46.16" class="nv-plane-radius"/>
      <circle data-point cx="155.84" cy="46.16" r="5" class="nv-plane-point"/>
      <text x="209" y="107">Re</text><text x="121" y="18">Im</text>
    </svg>
    <code class="nv-plane-code" hidden>const θ = <span data-code-angle>45</span> * Math.PI / 180;<br/>const z = &#123;<br/>&nbsp; re: <span data-code-real>0.707</span>,<br/>&nbsp; im: <span data-code-imag>0.707</span><br/>&#125;;</code>
  </div>
  <button type="button" class="nv-formula" data-angle disabled aria-label="Rotate the point on the complex plane"><span class="nv-expression">z = e<sup>iθ</sup></span><span class="nv-angle">θ = 45°</span></button>
  <label class="nv-plane-control"><span>Drag to explore</span><input type="range" data-plane-angle min="0" max="360" step="1" value="45" disabled aria-label="Complex angle in degrees" /></label>
  <div class="nv-plane-values" aria-hidden="true"><span>Re <output data-real>0.707</output></span><span>Im <output data-imag>0.707</output></span></div>
</aside>
