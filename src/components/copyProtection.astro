---
interface Props { copyProtection?: { blockSelection?: boolean; blockClipboard?: boolean; blockContextMenu?: boolean; blockDevTools?: boolean }; }
const p = Astro.props.copyProtection ?? {};
---
<div data-copy-protection data-selection={p.blockSelection || undefined} data-clipboard={p.blockClipboard || undefined} data-context={p.blockContextMenu || undefined} data-tools={p.blockDevTools || undefined} hidden></div>
<style is:global>
body:has([data-copy-protection][data-selection]) * { user-select:none!important; }
body:has([data-copy-protection][data-selection]) :is(input,textarea) { user-select:text!important; }
</style>
<script>
for (const name of ['copy','cut','paste','contextmenu','keydown']) document.addEventListener(name, event => {
 const p = document.querySelector<HTMLElement>('[data-copy-protection]')?.dataset;
 if (!p) return;
 if ((['copy','cut','paste'].includes(name) && p.clipboard) || (name === 'contextmenu' && p.context)) event.preventDefault();
 if (name === 'keydown' && p.tools) { const key = event as KeyboardEvent; if (key.key === 'F12' || key.ctrlKey && ['u','s'].includes(key.key.toLowerCase())) event.preventDefault(); }
});
</script>
