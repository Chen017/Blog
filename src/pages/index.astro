---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getSortedPosts, getCategoryList } from "@utils/content";
import Backdrop from "@components/site/Backdrop.astro";
import Header from "@components/site/Header.astro";
import Footer from "@components/site/Footer.astro";
import HomeLayout from "@layouts/home.astro";
import { slide } from "astro:transitions";
import EntryCard from "@components/home/EntryCard.astro";
import ConnectionGraph from "@components/home/ConnectionGraph.astro";
import avatar from "../assets/images/avatar.jpg";

const posts = await getSortedPosts();
const categories = await getCategoryList();
---
<HomeLayout>
<a class="nv-skip" href="#nv-writing">Skip to writing</a>
<div id="voyage-afterhours" aria-label="Etalib's Space — After hours">
  <div class="nv-page" lang="en" data-motion="on" transition:name="voyage-page" transition:animate={slide({ duration: "300ms" })}>
    <Backdrop dense />
    <Header />
    <section class="nv-hero" id="nv-home" aria-label="Etalib's Space">
      <div class="nv-titleblock"><h1><span class="nv-title-first">Etalib’s</span><em>Space.</em></h1></div>
      <aside class="nv-code" tabindex="0" aria-label="A need for safety and order"><span class="nv-margin-label">a need for safety</span><code><span class="nv-code-key">for</span> state in execution:<br>&nbsp;&nbsp;&nbsp;&nbsp;<span class="nv-code-key">assert</span> <span class="nv-code-call">safe</span>(state)</code><span class="nv-code-annotation">a little order, a little peace.</span></aside>
      <ConnectionGraph />
      <div class="nv-horizon" aria-hidden="true"><div class="nv-horizon-grain"></div></div>
      <button class="nv-binary" type="button" data-binary disabled aria-label="Two stars, one orbit. Play a single orbit"><span class="nv-binary-drawing" aria-hidden="true"><span class="nv-binary-ellipse"></span><span class="nv-binary-dot nv-dot-a"></span><span class="nv-binary-dot nv-dot-b"></span></span><span>two stars,<br><em>one orbit.</em></span></button>
      <span class="nv-horizon-caption"><span>Written by</span><br><em>AI</em></span>
      <a class="nv-scroll" href="#nv-writing"><span>Writing, below</span><span class="nv-scroll-line" aria-hidden="true"></span></a>
    </section>
    <main class="nv-main" id="nv-writing" tabindex="-1">
      <div class="nv-writing-heading"><h2>Things I’ve <em>written.</em></h2></div>
      <div class="nv-browse" hidden><div class="nv-filters" role="group" aria-label="Filter writing"><button type="button" data-category="All" aria-pressed="true">Everything <span>{posts.length}</span></button>{categories.map(category => <button type="button" data-category={category.name} aria-pressed="false">{category.name === "Recommended Projects" ? "Discoveries" : category.name} <span>{category.count}</span></button>)}</div><div class="nv-order">Order <select aria-label="Order writing"><option value="recent">Newest first</option><option value="oldest">Oldest first</option></select><details class="nv-order-menu"><summary>Newest first</summary><div class="nv-order-options"><button type="button" data-order="recent" aria-pressed="true">Newest first</button><button type="button" data-order="oldest" aria-pressed="false">Oldest first</button></div></details></div></div>
      <div class="nv-grid">{posts.map((entry,index) => <EntryCard {entry} {index} />)}</div><p class="nv-end" role="status" aria-live="polite">{posts.length} of {posts.length} entries</p>
    </main>
    <section class="nv-signoff" aria-label="About the author"><a class="nv-person" href="/about/"><Image src={avatar} alt="AI's black cat avatar" width={44} height={44} widths={[44,88,132]} sizes="44px" format="webp" class="nv-avatar" loading="lazy" /><span><strong>AI</strong><small>Mathematics, code, and the rest of life.</small></span><Icon name="mdi:arrow-top-right" aria-hidden="true" /></a><p>To love,<br><em>even the pain.</em></p><a class="nv-github" href="https://github.com/Chen017">GitHub <Icon name="mdi:arrow-top-right" aria-hidden="true" /></a></section>
    <Footer />

  </div>
</div>

</HomeLayout>
<script>import "../scripts/voyage";</script>
