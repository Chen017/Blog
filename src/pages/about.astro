---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/markdown.astro";
import GridLayout from "@layouts/grid.astro";
const about = await getEntry("spec", "about");
if (!about) throw new Error("About page content not found");
const { Content, headings } = await render(about);
---
<GridLayout title="About" description="Eta Lib. — mathematics, code, and the rest of life." {headings}>
    <section class="vs-about">
        <div class="vs-about-intro"><span class="vs-kicker">THE PERSON BEHIND THE PAGES</span><p>Mathematics, code, and the rest of life. A few things I chose to put here.</p></div>
        <Markdown class="vs-about-content"><Content /></Markdown>
    </section>
</GridLayout>
