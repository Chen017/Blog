---
export const prerender = true;
---
<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,nofollow" />
        <title>文章管理 · Etalib's Space</title>
        <link rel="stylesheet" href="/admin/editor.css" />
        <link rel="stylesheet" href="/admin/voyage-shell.css" />
    </head>
    <body>
        <script is:inline>window.CMS_MANUAL_INIT = true;</script>
        <script is:inline src="https://unpkg.com/decap-cms@3.17.1/dist/decap-cms.js"></script>
        <script is:inline src="/admin/components.js"></script>
        <script is:inline src="/admin/interface.js"></script>
        <script is:inline src="/admin/mdx-editor.js"></script>
        <script is:inline src="/admin/preview.js"></script>
        <script is:inline src="/admin/editor.js"></script>
        <script>
            import * as model from '../../cms/mdx-document.js';
            import { preview, katexStyle } from '../../cms/preview-runtime.js';
            declare global {
                interface Window { initBlogEditor: (model: typeof import('../../cms/mdx-document.js'), preview: typeof import('../../cms/preview-runtime.js').preview, katexStyle: string) => void; }
            }
            // Classic scripts above register controls before this deferred module runs.
            window.initBlogEditor(model, preview, katexStyle);
        </script>
    </body>
</html>
