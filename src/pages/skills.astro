---
import { skillsData } from "@utils/skills";
import GridLayout from "@layouts/grid.astro";
const categories = [...new Set(skillsData.map(skill => skill.category))].sort();
const labels: Record<string,string> = { ai:"AI", backend:"Backend", frontend:"Frontend", client:"Client", web:"Web", database:"Databases", engines:"Engines", tools:"Tools", system:"Systems", others:"Other" };
const duration = (years: number, months: number) => [years ? years + (years === 1 ? " year" : " years") : "", months ? months + (months === 1 ? " month" : " months") : ""].filter(Boolean).join(" ") || "Just starting";
---
<GridLayout title="Skills" description="Tools and subjects I have spent time learning.">
    <header class="vs-page-head"><span class="vs-kicker">LEARNING / {skillsData.length} SKILLS</span><h1>Things I work <em>with.</em></h1><p>Tools and subjects I have spent time learning. There is always more to understand.</p></header>
    {categories.map(category => <section class="vs-skill-group"><h2>{labels[category] || category}</h2><div class="vs-skill-grid">{skillsData.filter(skill => skill.category === category).map(skill => <article class="vs-skill"><h3>{skill.name}</h3><p>{skill.description}</p><div class="vs-skill-meta"><span>{skill.level}</span><span>{duration(skill.experience.years, skill.experience.months)}</span></div>{Boolean(skill.certifications?.length) && <p>{skill.certifications?.join(" · ")}</p>}</article>)}</div></section>)}
</GridLayout>
