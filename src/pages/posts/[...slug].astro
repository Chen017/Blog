---
import { render, type CollectionEntry } from "astro:content";
import { profileConfig, siteConfig, postConfig } from "@/config";
import { getSortedPosts } from "@utils/content";
import { homePostCopy } from "@utils/home-post";
import { getFileDirFromPath, getPostUrl, removeFileExtension } from "@utils/url";
import { normalizePostRoute } from "@utils/route-name";
import { getCategoryUrl } from "@utils/url";
import Markdown from "@components/common/markdown.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";
import Comment from "@components/comment.astro";
import CopyProtection from "@components/copyProtection.astro";
import PasswordProtection from "@components/common/passwordProtection.astro";
import GridLayout from "@layouts/grid.astro";

export async function getStaticPaths() {
    const blogEntries = await getSortedPosts();
    const paths: {
        params: { slug: string };
        props: { entry: CollectionEntry<"posts"> };
    }[] = [];
    const owners = new Map<string, string>();
    const addPath = (slug: string, entry: CollectionEntry<"posts">) => {
        const owner = owners.get(slug);
        if (owner && owner !== entry.id) throw new Error(`Post route collision: ${slug} (${owner}, ${entry.id})`);
        if (owner) return;
        owners.set(slug, entry.id);
        paths.push({ params: { slug }, props: { entry } });
    };

    for (const entry of blogEntries) {
        // 将 id 转换为 slug（移除扩展名）以匹配路由参数
        const slug = removeFileExtension(entry.id);
        // 为每篇文章创建默认的 slug 路径
        addPath(slug, entry);
        // 如果文章有自定义固定链接，也创建对应的路径
        if (entry.data.routeName) {
            // 移除开头的斜杠和结尾的斜杠
            // 同时移除可能的 "posts/" 前缀，避免重复
            const routeName = normalizePostRoute(entry.data.routeName);
            addPath(routeName, entry);
        }
    }

    return paths;
}



const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const copy = homePostCopy(entry.data);
const allPosts = await getSortedPosts();
const adjacent = (id: string) => allPosts.find(post => post.id === id);
const previous = adjacent(entry.data.nextSlug);
const next = adjacent(entry.data.prevSlug);
const published = entry.data.published!.toISOString().slice(0,10);
const updated = entry.data.updated?.toISOString().slice(0,10);
const shortNote = !entry.data.encrypted && copy.category === "Life" && Number(remarkPluginFrontmatter.words) < 160;
const jsonLd = {
    "@context": "https://schema.org", "@type": "BlogPosting", headline: copy.title,
    description: copy.description, author: { "@type": "Person", name: profileConfig.name, url: Astro.site },
    datePublished: published, dateModified: updated || published,
    inLanguage: entry.data.lang || siteConfig.lang,
    mainEntityOfPage: new URL(getPostUrl(entry), Astro.site).toString(),
};
---
<GridLayout title={copy.title} description={copy.description} lang={entry.data.lang || "en"} canonical={getPostUrl(entry)} setOGTypeArticle postSlug={entry.id} dynamicOutline={entry.data.encrypted} headings={entry.data.encrypted ? [] : headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')} />
        <header slot="intro" class="vs-article-head" data-kind={shortNote ? "note" : "essay"} data-title-length={copy.title.length > 85 ? "long" : "short"}>
            <div class="vs-return-links"><button type="button" class="vs-source-back" data-source-back hidden>← Back to selection</button><a class="vs-back" href="/#nv-writing">All writing ↗</a></div>
            <div class="vs-article-kicker"><a href={getCategoryUrl(entry.data.category)}>{copy.category}</a>{!shortNote && <span>{remarkPluginFrontmatter.minutes} min read</span>}</div>
            <h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{copy.title}</h1>
            {copy.description && !shortNote && <p class="vs-deck">{copy.description}</p>}
            <div class="vs-article-meta"><span>{profileConfig.name}</span><time datetime={published}>{published}</time>{postConfig.showLastModified && updated && <span>Updated <time datetime={updated}>{updated}</time></span>}{!shortNote && <span>{remarkPluginFrontmatter.words} words</span>}</div>
        </header>
    <article id="post-container" class="vs-article" data-kind={shortNote ? "note" : "essay"}>
        {entry.data.cover && entry.data.coverInContent && <ImageWrapper id="post-cover" src={entry.data.cover} basePath={getFileDirFromPath(entry.filePath || "")} alt="" class="vs-inline-cover" loading="lazy" />}
        <PasswordProtection isEncrypted={entry.data.encrypted} password={entry.data.password}><Markdown class="markdown-content"><Content /></Markdown></PasswordProtection>
        {postConfig.showLastModified && <p class="vs-updated">Last edited <time datetime={updated || published}>{updated || published}</time>.</p>}
    </article>
    <Comment post={entry} />
    <nav class="vs-adjacent" aria-label="Adjacent writing">
        {previous && <a href={getPostUrl(previous)} data-direction="previous"><span>← Previous entry</span><strong>{homePostCopy(previous.data).title}</strong></a>}
        {next && <a href={getPostUrl(next)} data-direction="next"><span>Next entry →</span><strong>{homePostCopy(next.data).title}</strong></a>}
    </nav>
    <CopyProtection copyProtection={entry.data.copyProtection} />
</GridLayout>
