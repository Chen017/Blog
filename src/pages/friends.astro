---
import { getEntry, render } from "astro:content";
import { friendsData } from "@utils/friends";
import Markdown from "@components/common/markdown.astro";
import GridLayout from "@layouts/grid.astro";
const friends = await getEntry("spec", "friends");
if (!friends) throw new Error("Links page content not found");
const { Content } = await render(friends);
---
<GridLayout title="Links" description="My other websites, under the same sky.">
    <header class="vs-page-head"><span class="vs-kicker">ELSEWHERE</span><h1>Other little <em>worlds.</em></h1><p>My other websites, under the same sky.</p></header>
    <div class="vs-link-grid">{friendsData.map(item => <a class="vs-destination" href={item.siteurl} target="_blank" rel="noopener noreferrer"><span class="vs-destination-mark" aria-hidden="true"><span class="vs-mark-letter">{item.title.slice(0,1)}</span><img src={item.imgurl} alt="" width="64" height="64" loading="lazy" data-fallback-artwork /></span><div><h2>{item.title}</h2><p>{item.desc}</p>{Boolean(item.tags?.length) && <small>{item.tags?.join(" / ")}</small>}</div><span class="vs-external" aria-hidden="true">↗</span></a>)}</div>
    <Markdown class="mt-8"><Content /></Markdown>
</GridLayout>
