---
import { getSortedPostsList } from "@utils/content";
import ArchivePanel from "@components/archivePanel.svelte";
import GridLayout from "@layouts/grid.astro";
const sortedPostsList = await getSortedPostsList();
---
<GridLayout title="Archive" description="Every note, project, and personal entry, in one place.">
    <header class="vs-page-head"><span class="vs-kicker">THE WRITING / {sortedPostsList.length} ENTRIES</span><h1>Over the <em>years.</em></h1></header>
    <ArchivePanel sortedPosts={sortedPostsList} client:idle />
</GridLayout>
