---
import type { GetStaticPaths } from "astro";
import { PAGE_SIZE } from "@constants/constants";
import { getSortedPosts } from "@utils/content";
import Pagination from "@components/pagination.astro";
import EntryCard from "@components/home/EntryCard.astro";
import GridLayout from "@layouts/grid.astro";
export const getStaticPaths = (async ({ paginate }) => paginate(await getSortedPosts(), { pageSize: PAGE_SIZE }).filter(route => route.params.page)) satisfies GetStaticPaths;
const { page } = Astro.props;
---
<GridLayout title={"Writing — Page " + page.currentPage}>
    <header class="vs-page-head"><span class="vs-kicker">THE WRITING / PAGE {page.currentPage}</span><h1>A little <em>further.</em></h1><p>Continue through the notes, projects, and personal entries.</p></header>
    <div class="vs-page-grid">{page.data.map((entry,index) => <EntryCard {entry} {index} />)}</div>
    <Pagination page={page} />
</GridLayout>
