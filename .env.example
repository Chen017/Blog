# Copy these settings into /root/Blog/.env on the VPS. Never commit real secrets.
# GitHub OAuth App homepage: https://www.etalib.space
# Authorization callback URL: https://www.etalib.space/oauth/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
CMS_SITE_URL=https://www.etalib.space
CMS_GITHUB_REPO=Chen017/Blog
CMS_ALLOWED_USERS=Chen017

# Optional build-time analytics counts; never place this key in the YAML config.
UMAMI_API_KEY=
